{
  "version": 2,
  "builds": [
    {
      "src": "lottobot/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "lottobot/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "lottobot.settings"
  }
}